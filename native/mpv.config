# mpv meson options — LGPLv2.1+ build (ADR-0002).
#
# Sourced by native/build.sh. One option per line; `#` comments and blank lines ignored.
#
# `-Dgpl=false` is the option the entire licensing posture rests on: it produces an LGPLv2.1+
# libmpv, which is what makes App Store distribution possible at all (docs/08 §3.1).
#
# 🔴 R1: the set of components excluded by -Dgpl=false has changed across mpv releases. Verify
# against the pinned version and record the delta — see native/README.md, "S4 deliverable".

# ── Licence posture ──────────────────────────────────────────────────────────────────────────────
-Dgpl=false
-Dlibmpv=true
-Dcplayer=false          # we embed the library; the CLI player is not shipped
-Ddefault_library=shared # LGPL §6 relinkability

# ── Render pipeline (docs/03 §1.2, §4) ───────────────────────────────────────────────────────────
# gpu-next is the libplacebo-based renderer: BT.2390 tone mapping, HDR10+/DV metadata handling,
# user shaders (Anime4K, FSRCNNX, CAS). This is the quality ceiling the product is built on.
-Dlibplacebo-next=enabled
-Dvulkan=enabled
-Dgl=enabled
-Dshaderc=enabled
-Dspirv-cross=enabled

# ── Subtitles ────────────────────────────────────────────────────────────────────────────────────
-Dlibass=enabled         # ISC — the ASS/SSA correctness reference
-Duchardet=enabled       # legacy subtitle charset detection (docs/11 §5)

# ── Disc structures (docs/03 §5.2) ───────────────────────────────────────────────────────────────
-Dlibbluray=enabled      # LGPLv2.1+, no AACS/BD+ decryption
-Ddvdnav=disabled        # GPLv2+ — excluded by ADR-0002 §1.3. Costs DVD menus, not playback.
-Dcdda=disabled

# ── Audio: exclusive/passthrough paths matter more here than anywhere else (docs/03 §5.4) ────────
-Dpipewire=enabled
-Dalsa=enabled
-Dpulse=enabled
-Djack=disabled

# ── Not needed in an embedded library ────────────────────────────────────────────────────────────
-Dlua=disabled           # scripting is our plugin system's job (docs/06), sandboxed
-Djavascript=disabled
-Dmanpage-build=disabled
-Dhtml-build=disabled

# ── Per-platform additions applied by build.sh ───────────────────────────────────────────────────
# linux   : -Dwayland=enabled -Dx11=enabled -Dvaapi=enabled -Ddrm=enabled
# windows : -Dd3d11=enabled -Dwasapi=enabled
# macos   : -Dcocoa=enabled -Dvideotoolbox-gl=enabled -Dcoreaudio=enabled
# ios/tvos: -Dios-gl=enabled -Dcoreaudio=enabled -Dcocoa=disabled
# android : -Dandroid-media-ndk=enabled -Degl-android=enabled
