# FFmpeg configure flags — LGPL-only, dynamically linked (ADR-0002).
#
# Sourced by native/build.sh. One flag per line; `#` comments and blank lines ignored.
#
# THE RULE: never add --enable-gpl, --enable-nonfree, --enable-version3, libx264, libx265, or
# libfdk-aac. ci/license-gate.sh fails the build if any appear. The transcoding requirement is met
# by hardware encoders plus permissively-licensed software encoders — see docs/13 §3.1.

# ── Licence posture ──────────────────────────────────────────────────────────────────────────────
--disable-gpl
--disable-nonfree
--enable-shared
--disable-static

# ── Size: we embed a player, not the CLI suite ───────────────────────────────────────────────────
--disable-programs
--disable-doc
--enable-avdevice
--enable-swscale
--enable-swresample
--enable-avfilter

# ── Encoders: permissive only (BSD/ISC), plus every hardware path ────────────────────────────────
# SVT-AV1 and libaom are BSD; libvpx is BSD; libopus and libvorbis are BSD; libmp3lame is LGPL.
# Together these cover every server-side transcode target in docs/13 §3.1 without touching GPL.
--enable-libsvtav1
--enable-libaom
--enable-libvpx
--enable-libopus
--enable-libvorbis
--enable-libmp3lame

# ── Subtitles and text ───────────────────────────────────────────────────────────────────────────
--enable-libass          # ISC. The correctness reference for ASS/SSA (docs/11 §5).
--enable-libfreetype
--enable-libfribidi      # LGPL. Required for correct RTL (Arabic/Hebrew) subtitle shaping.
--enable-libharfbuzz

# ── Disc structures (docs/03 §5.2) ───────────────────────────────────────────────────────────────
# libbluray is LGPLv2.1+ and does NOT decrypt AACS/BD+ — keep it that way (docs/08 §4).
--enable-libbluray
# NOTE: libdvdnav/libdvdread are GPLv2+ and are therefore NOT enabled. DVD folders play via the
# main-title path rather than menu navigation. See ADR-0002 §1.3.

# ── Network sources (docs/03 §7) ─────────────────────────────────────────────────────────────────
--enable-libsmbclient    # LGPLv3 — verify per-platform; libsmb2 (LGPL2.1) is the fallback.
--enable-libssh
--enable-librist
--enable-libsrt
--enable-openssl         # or --enable-mbedtls where OpenSSL linking is awkward

# ── Extra format coverage from permissive libraries (docs/11 §3.3, §4.3) ─────────────────────────
--enable-libopenmpt      # BSD. Tracker/module formats.
--enable-libdav1d        # BSD. The fast AV1 decoder.
--enable-libzimg
--enable-libplacebo      # LGPLv2.1+. The HDR/tone-mapping pipeline (docs/03 §4).

# ── Hardware acceleration: enabled per-platform by build.sh ──────────────────────────────────────
# linux   : --enable-vaapi --enable-vdpau --enable-vulkan --enable-ffnvcodec --enable-libvpl
# windows : --enable-d3d11va --enable-dxva2 --enable-ffnvcodec --enable-libvpl --enable-amf
# macos   : --enable-videotoolbox --enable-audiotoolbox
# ios/tvos: --enable-videotoolbox --enable-audiotoolbox
# android : --enable-mediacodec --enable-jni --enable-vulkan
